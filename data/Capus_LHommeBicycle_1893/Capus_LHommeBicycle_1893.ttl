@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sf: <https://w3id.org/ontosf/ontology#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ontosf/data> a owl:Ontology ;
    dc:created "2026-09-14"^^xsd:date ;
    dc:creator "Mathilde Ducos" ;
    dc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dc:title "SFonto" ;
    dcterms:bibliographicCitation "" ;
    dcterms:created "2026-09-14"^^xsd:date ;
    dcterms:creator "Mathilde Ducos" ;
    dcterms:hasVersion "0.1.0" ;
    dcterms:identifier <https://w3id.org/ontosf/ontology> ;
    dcterms:issued "2026-09-14"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher "" ;
    dcterms:status "unstable" ;
    vann:preferredNamespacePrefix "sf" ;
    vann:preferredNamespaceUri "https://w3id.org/ontosf/ontology#" ;
    rdfs:comment "SFonto is an ontology for the content of science-fiction narratives, adapted from the GOLEM ontology."@en ;
    owl:imports <https://w3id.org/ontosf/ontology> ;
    owl:versionIRI <https://w3id.org/ontosf/data/> .

sf:Archetype_Child_Prodigy a gc:G0_Character-Stoff ;
    rdfs:label "A precocious, self-taught genius"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Archetype_Melancholic_Hero a gc:G0_Character-Stoff ;
    rdfs:label "A melancholic hero who has achieved everything"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Archetype_Strong_Southern_Man a gc:G0_Character-Stoff ;
    rdfs:label "The archetype of the strong man of the South"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Bicycle_man a sf:H2_Concrete_Novum ;
    rdfs:label "Bicycle man"@en ;
    crm:P2_has_type sf:type_biological_novum ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Bourgeoisie a dul:Community ;
    rdfs:label "Bourgeoisie social class"@en ;
    crm:P2_has_type sf:type_social_class ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle ;
    dul:hasMember sf:Marius,
        sf:Marius_Father .

sf:Expr_FR_LHomme_Bicycle a lrmoo:F2_Expression ;
    rdfs:label "French Expression of L'Homme-bicycle"@en ;
    lrmoo:R3i_realises sf:Work_LHomme_Bicycle ;
    dc:language "fr" ;
    dcterms:issued "1983"^^xsd:gYear ;
    crm:P2_has_type sf:type_written_text .

sf:French_press a dul:Organization ;
    rdfs:label "French press"@en ;
    crm:P2_has_type sf:type_media ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:High_and_middle_Schools a gc:G13_Narrative_Location ;
    rdfs:label "High and middle schools"@en ;
    crm:P2_has_type sf:type_institutional_location .

sf:Humanity20th_KnowsByReputation a sf:H7_Relationship_Assignment ;
    rdfs:label "Humanity of the 20th century knows by reputation"@en ;
    dolce:generic-dependant-on sf:Event_world_celebrity ;
    dlpext:d-uses sf:KnowsByReputation_Role ;
    sf:HP11_for_relationship sf:Rel_Humanity20th_Marius ;
    sf:HP12i_is_relation_of sf:Humanity_20th .

sf:Kamtchatka_real a dlpcom:geographical-place ;
    rdfs:label "Kamtchatka (real)"@en ;
    crm:P2_has_type sf:type_region .

sf:King_ParentOf a sf:H7_Relationship_Assignment ;
    rdfs:label "King is the parent of"@en ;
    dolce:generic-dependant-on sf:Event_meet_Marius_Princess ;
    dlpext:d-uses sf:ParentOf_Role ;
    sf:HP11_for_relationship sf:Rel_Princess_King ;
    sf:HP12i_is_relation_of sf:King .

sf:Local_Doctor_Achievement_Striving a sf:H5_Personality_Assignment ;
    rdfs:label "Local doctor's achievement striving"@en ;
    sf:HP7_has_facet sf:Achievement_Striving ;
    sf:HP8_has_valence sf:Negative_Valence ;
    sf:HP9i_is_personality_of sf:Local_Doctor .

sf:Local_Doctor_Emotionality a sf:H5_Personality_Assignment ;
    rdfs:label "Local doctor's emotionality"@en ;
    sf:HP7_has_facet sf:Emotionality ;
    sf:HP8_has_valence sf:Negative_Valence ;
    sf:HP9i_is_personality_of sf:Local_Doctor .

sf:Local_Doctor_Trust a sf:H5_Personality_Assignment ;
    rdfs:label "Local doctor's trust"@en ;
    sf:HP7_has_facet sf:Trust ;
    sf:HP8_has_valence sf:Negative_Valence ;
    sf:HP9i_is_personality_of sf:Local_Doctor .

sf:MariusFather_ParentOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Marius' Father is the parent of"@en ;
    dolce:generic-dependant-on sf:Event_Marius_Birth ;
    dlpext:d-uses sf:ParentOf_Role ;
    sf:HP11_for_relationship sf:Rel_Marius_MariusFather ;
    sf:HP12i_is_relation_of sf:Marius_Father .

sf:MariusSon_ChildOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Marius' Son is the child of"@en ;
    dolce:generic-dependant-on sf:Event_son_birth ;
    dlpext:d-uses sf:ChildOf_Role ;
    sf:HP11_for_relationship sf:Rel_Princess_MariusSon ;
    sf:HP12i_is_relation_of sf:Marius_Son .

sf:Marius_Cautiousness a sf:H5_Personality_Assignment ;
    rdfs:label "Marius' cautiousness"@en ;
    sf:HP7_has_facet sf:Cautiousness ;
    sf:HP8_has_valence sf:Negative_Valence ;
    sf:HP9i_is_personality_of sf:Marius .

sf:Marius_Cheerfulness a sf:H5_Personality_Assignment ;
    rdfs:label "Marius' cheerfulness"@en ;
    sf:HP7_has_facet sf:Cheerfulness ;
    sf:HP8_has_valence sf:Positive_Valence ;
    sf:HP9i_is_personality_of sf:Marius .

sf:Marius_ChildOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Marius is the child of"@en ;
    dolce:generic-dependant-on sf:Event_Marius_Birth ;
    dlpext:d-uses sf:ChildOf_Role ;
    sf:HP11_for_relationship sf:Rel_Marius_MariusFather ;
    sf:HP12i_is_relation_of sf:Marius .

sf:Marius_Intellect a sf:H5_Personality_Assignment ;
    rdfs:label "Marius' intellect"@en ;
    sf:HP7_has_facet sf:Intellect ;
    sf:HP8_has_valence sf:Positive_Valence ;
    sf:HP9i_is_personality_of sf:Marius .

sf:Marius_PassiveOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Marius is the passive of"@en ;
    dolce:generic-dependant-on sf:Event_world_celebrity ;
    dlpext:d-uses sf:Passive_Role ;
    sf:HP11_for_relationship sf:Rel_Humanity20th_Marius ;
    sf:HP12i_is_relation_of sf:Marius .

sf:Marius_SpouseOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Marius is the spouse of"@en ;
    dolce:generic-dependant-on sf:Event_wedding ;
    dlpext:d-uses sf:SpouseOf_Role ;
    sf:HP11_for_relationship sf:Rel_Marius_Princess ;
    sf:HP12i_is_relation_of sf:Marius .

sf:Means_of_transportation a gc:G16_Object ;
    rdfs:label "Common means of transportation"@en ;
    crm:P2_has_type sf:type_technological_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Medecine_academy a dul:Organization ;
    rdfs:label "Medecine Academy"@en ;
    crm:P2_has_type sf:type_academic_institution ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle ;
    dul:hasLocation sf:Paris ;
    dul:hasMember sf:Paris_Surgeons .

sf:Midi a gc:G13_Narrative_Location ;
    rdfs:label "Midi"@en ;
    crm:P2_has_type sf:type_region ;
    crm:P67_refers_to sf:Midi_real ;
    dolce:proper-part sf:Provence .

sf:Pattern_Birth_of_a_New_Race a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of the birth of a new race"@en ;
    crm:P130i_features_are_also_found_on sf:Sequence_Hybrid_race_birth .

sf:Pattern_Hero_Surpassing_Humanity a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of the hero who transcends the limits of humanity"@en ;
    crm:P130i_features_are_also_found_on sf:Sequence_Mastering_bicycle .

sf:Pattern_Man-Machine_Hybridization a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of human-machine hybridization"@en ;
    crm:P130i_features_are_also_found_on sf:Sequence_Bicycle_hybridization .

sf:Pattern_Science_Powerless_Against_the_Fantastic a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of science's powerlessness in the face of the fantastical"@en ;
    crm:P130i_features_are_also_found_on sf:Sequence_Medicine_fails_to_diagnose_a_disease .

sf:Princess_ChildOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Princess is the child of"@en ;
    dolce:generic-dependant-on sf:Event_meet_Marius_Princess ;
    dlpext:d-uses sf:ChildOf_Role ;
    sf:HP11_for_relationship sf:Rel_Princess_King ;
    sf:HP12i_is_relation_of sf:Princess .

sf:Princess_ParentOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Princess is the parent of"@en ;
    dolce:generic-dependant-on sf:Event_son_birth ;
    dlpext:d-uses sf:ParentOf_Role ;
    sf:HP11_for_relationship sf:Rel_Princess_MariusSon ;
    sf:HP12i_is_relation_of sf:Princess .

sf:Princess_SpouseOf a sf:H7_Relationship_Assignment ;
    rdfs:label "Princess is the spouse of"@en ;
    dolce:generic-dependant-on sf:Event_wedding ;
    dlpext:d-uses sf:SpouseOf_Role ;
    sf:HP11_for_relationship sf:Rel_Marius_Princess ;
    sf:HP12i_is_relation_of sf:Princess .

sf:State_love a gc:G3_Psychological_State ;
    rdfs:label "Love"@en ;
    dlpfun:state-of sf:Princess ;
    dlptem:follows sf:Event_meet_Marius_Princess .

sf:State_melancholy a gc:G3_Psychological_State ;
    rdfs:label "Melancholy"@en ;
    dlpfun:state-of sf:Marius ;
    dlptem:temporally-overlaps sf:Event_melancholy .

sf:University a gc:G13_Narrative_Location ;
    rdfs:label "University"@en ;
    crm:P2_has_type sf:type_institutional_location .

sf:Bicycle a gc:G16_Object ;
    rdfs:label "Bicycle"@en ;
    crm:P2_has_type sf:type_technological_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle ;
    dlpext:setting sf:Setting_bicycle_society .

sf:Bicycle_men_race a dul:Community,
        sf:H1_Conceptual_Novum ;
    rdfs:label "Race of bicycle men"@en ;
    crm:P2_has_type sf:type_biological_novum,
        sf:type_fictive_species ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle ;
    dul:hasMember sf:Marius,
        sf:Marius_Son .

sf:Countryside a gc:G13_Narrative_Location ;
    rdfs:label "Countryside"@en ;
    crm:P2_has_type sf:type_natural_location .

sf:English_participants a dul:Group ;
    rdfs:label "English participants"@en ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Humanity_20th a dul:Community ;
