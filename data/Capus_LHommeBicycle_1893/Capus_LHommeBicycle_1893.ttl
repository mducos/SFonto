sf:Setting_around_1900 a gc:G12_Setting ;
    rdfs:label "Around 1900"@en ;
    crm:P2_has_type sf:type_historical_period .

sf:Time_Marius_20yo a dolce:time-interval ;
    rdfs:label "Marius is 20 years old"@en .

sf:Time_Marius_4yo a dolce:time-interval ;
    rdfs:label "Marius is 4 years old"@en .

sf:Doctor_potion a gc:G16_Object ;
    rdfs:label "The potion prescribed by the doctor"@en ;
    crm:P2_has_type sf:type_medical_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Holy_water a gc:G16_Object ;
    rdfs:label "Holy water"@en ;
    crm:P2_has_type sf:type_religious_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:King a sf:H3_Human_Character ;
    rdfs:label "The King"@en ;
    dlpext:setting sf:Setting_bicycle_society ;
    schema:gender sf:Male_character ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:NU01 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius is from Provence"@en ;
    crm:P67_refers_to sf:Event_Marius_Birth ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU02 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius inherits his strength from father to son"@en ;
    crm:P67_refers_to sf:Event_Marius_Birth ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU03 a gc:G9_Narrative_Unit ;
    rdfs:label "Bicycle replaced the other means of transportation"@en ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU04 a gc:G9_Narrative_Unit ;
    rdfs:label "Bicycle is part of the bourgeoisie education"@en ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU05 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius' father offers a bicycle to Marius"@en ;
    crm:P67_refers_to sf:Event_4th_Birthday_Bicycle_Gift ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle ;
    dlpext:plays sf:Function_magical_agent .

sf:NU07 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius wins the Paris-Kamtchatka ride"@en ;
    crm:P67_refers_to sf:Event_Paris_to_Kamchatka_Ride ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU08 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius experiences melancholy"@en ;
    crm:P67_refers_to sf:Event_melancholy ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle ;
    dlpext:plays sf:Function_lack .

sf:NU11 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius' father is unable to separate Marius and his bicycle"@en ;
    crm:P67_refers_to sf:Event_family_mockery ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU12 a gc:G9_Narrative_Unit ;
    rdfs:label "The pastor attempts to exorcise Marius"@en ;
    crm:P67_refers_to sf:Event_exorcism_pastor ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU17 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius grows accustomed to his condition"@en ;
    crm:P67_refers_to sf:Event_world_celebrity ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU18 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius refuses to exhibit"@en ;
    crm:P67_refers_to sf:Event_exhibition_refusal ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU19 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius receives the legion of honor"@en ;
    crm:P67_refers_to sf:Event_Legion_of_Honor ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU20 a gc:G9_Narrative_Unit ;
    rdfs:label "The pincess falls in love with Marius"@en ;
    crm:P67_refers_to sf:Event_meet_Marius_Princess ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle .

sf:NU21 a gc:G9_Narrative_Unit ;
    rdfs:label "Marius marries the princess"@en ;
    crm:P67_refers_to sf:Event_wedding ;
    dolce:proper-part-of sf:Work_LHomme_Bicycle ;
    dlpext:plays sf:Function_wedding .

sf:Paris a gc:G13_Narrative_Location ;
    rdfs:label "Paris"@en ;
    crm:P2_has_type sf:type_city ;
    crm:P67_refers_to sf:Paris_real .

sf:Pastor a sf:H3_Human_Character ;
    rdfs:label "The pastor"@en ;
    dlpext:setting sf:Setting_bicycle_society ;
    dlpext:uses sf:Holy_water ;
    schema:gender sf:Male_character ;
