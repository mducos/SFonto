@prefix sf: <https://w3id.org/ontosf/ontology#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix gc: <https://w3id.org/golem/ontology#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix dlpext: <http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#> .
@prefix dlpcom: <http://www.ontologydesignpatterns.org/ont/dlp/CommonSenseMapping.owl#> .
@prefix dlpspa: <http://www.ontologydesignpatterns.org/ont/dlp/SpatialRelations.owl#> .
@prefix dlptem: <http://www.ontologydesignpatterns.org/ont/dlp/TemporalRelations.owl#> .
@prefix dlpfun: <http://www.ontologydesignpatterns.org/ont/dlp/FunctionalParticipation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix schema: <https://schema.org/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix dolce: <http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#> .

<https://w3id.org/ontosf/data> rdf:type owl:Ontology ;
                                    owl:versionIRI <https://w3id.org/ontosf/data/> ;
                                    owl:imports <https://w3id.org/ontosf/ontology> ;
                                    dc:created "2026-06-04"^^xsd:date ;
                                    dc:creator "Mathilde Ducos" ;
                                    dc:license <https://creativecommons.org/licenses/by/4.0/> ;
                                    dc:title "SFonto" ;
                                    dcterms:bibliographicCitation "" ;
                                    dcterms:created "2026-06-04"^^xsd:date ;
                                    dcterms:creator "Mathilde Ducos" ;
                                    dcterms:hasVersion "0.1.0" ;
                                    dcterms:identifier <https://w3id.org/ontosf/ontology> ;
                                    dcterms:issued "2026-06-04"^^xsd:date ;
                                    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                    dcterms:publisher "" ;
                                    dcterms:status "unstable" ;
                                    vann:preferredNamespacePrefix "sf" ;
                                    vann:preferredNamespaceUri "https://w3id.org/ontosf/ontology#" ;
                                    rdfs:comment "SFonto is an ontology for the content of science-fiction narratives, adapted from the GOLEM ontology."@en .


#################################################################
# Instances
#################################################################

sf:Work_LHomme_Bicycle a lrmoo:F1_Work ;
    rdfs:label "L'Homme-bicycle (work)"@en ;
    dcterms:title "L'Homme-bicycle"@fr ;
    dcterms:alternative "légende pour l'an 1900"@fr ;
    dcterms:creator "Alfred Capus" ;
    dcterms:issued "1893"^^xsd:gYear ;
    crm:P2_has_type sf:type_short_story ;
    gc:GP0_has_feature sf:Feature_science_fiction ;
    gc:GP0_has_feature sf:Feature_third_person_narrator ;
    gc:GP0_has_feature sf:Feature_heterodiegetic_narrator ;
    gc:GP0_has_feature sf:Feature_humorous_register ;
    dlpext:satisfied_by sf:Setting_around_1900 ;
    dlpext:satisfied_by sf:Setting_bicycle_society ;
    dlpext:d-uses sf:Syuzhet_LHomme_Bicycle ;
    dlpext:d-uses sf:Fabula_LHomme_Bicycle .

sf:Expr_FR_LHomme_Bicycle a lrmoo:F2_Expression ;
    rdfs:label "French Expression"@en ;
    dcterms:issued "1893"^^xsd:gYear ;
    crm:P2_has_type sf:type_written_text ;
    lrmoo:R3i_realises sf:Work_LHomme_Bicycle ;
    dc:language "fr" .

sf:type_short_story a crm:E55_Type ;
    rdfs:label "Short story" .

sf:Marius a sf:H3_Human_Character, sf:H4_Non-human_Character ;
    rdfs:label "Marius"@en ;
    dlpext:setting sf:Setting_bicycle_society ;
    schema:birthPlace sf:Provence ;
    gc:GP0_has_feature sf:Physical_ability ;
    gc:GP0_has_feature sf:Fame ;
    schema:gender sf:Male_character ;
    dlpext:uses sf:Bicycle ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle ;
    dlpext:plays sf:Role_hero ;
    sf:becomes_non_human_at sf:NU16 .

sf:Native_of_Provence a gc:G17_Character_Feature ;
    rdfs:label "A native of Provence"@en ;
    crm:P2_has_type sf:biographical_feature .

sf:Physical_ability a gc:G17_Character_Feature ;
    rdfs:label "Gifted at physical exercise"@en ;
    crm:P2_has_type sf:physical_feature .

sf:Fame a gc:G17_Character_Feature ;
    rdfs:label "Famous character"@en ;
    crm:P2_has_type sf:biographical_feature .

sf:Marius_Father a sf:H3_Human_Character ;
    rdfs:label "Marius' father"@en ;
    gc:GP0_has_feature sf:Male_character ;
    dlpext:setting sf:Setting_bicycle_society ;
    dlpext:plays sf:Role_donor ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:Princess a sf:H3_Human_Character ;
    rdfs:label "The Princess"@en ;
    gc:GP0_has_feature sf:Female_character ;
    dlpext:setting sf:Setting_bicycle_society ;
    gc:GP0_has_feature sf:Beauty ;
    dlpext:plays sf:Role_princess ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .
    
sf:Beauty a gc:G17_Character_Feature ;
    rdfs:label "Beautiful"@en ;
    crm:P2_has_type sf:physical_feature .

sf:King a sf:H3_Human_Character ;
    rdfs:label "The King"@en ;
    dlpext:setting sf:Setting_bicycle_society ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:Local_Doctor a sf:H3_Human_Character ;
    rdfs:label "The local doctor"@en ;
    gc:GP0_has_feature sf:Male_character ;
    dlpext:setting sf:Setting_bicycle_society ;
    dlpext:uses sf:Doctor_potion ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:Pastor a sf:H3_Human_Character ;
    rdfs:label "The pastor"@en ;
    gc:GP0_has_feature sf:Male_character ;
    dlpext:setting sf:Setting_bicycle_society ;
    dlpext:uses sf:Holy_water ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:Marius_Son a sf:H4_Non-human_Character ;
    rdfs:label "Marius' son"@en ;
    gc:GP0_has_feature sf:Male_character ;
    dlpext:setting sf:Setting_bicycle_society ;
    gc:GP0_has_feature sf:Born_on_natural_bicycle ;
    gc:GP1_is_character_in sf:Work_LHomme_Bicycle .

sf:Born_on_natural_bicycle a gc:G17_Character_Feature ;
    rdfs:label "Born on a natural bicycle"@en ;
    rdfs:comment "Born riding a little bicycle of flesh and bone"@en ;
    crm:P2_has_type sf:physical_feature .

sf:Medecine_academy a dul:Organization ;
    rdfs:label "Medecine Academy"@en ;
    dul:hasMember sf:Paris_surgeons ;
    dul:hasLocation sf:Paris ;
    crm:P2_has_type sf:type_medical_institution ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:French_press a dul:Organization ;
    rdfs:label "French press"@en ;
    crm:P2_has_type sf:type_media ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Bourgeoisie a dul:Community ;
    rdfs:label "Bourgeoisie"@en ;
    dul:hasMember sf:Marius ;
    dul:hasMember sf:Marius_Father ;
    crm:P2_has_type sf:type_social_class ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Setting_bicycle_society a gc:G12_Setting ;
    rdfs:label "Society dominated by the bicycle"@en ;
    crm:P2_has_type sf:type_society .

sf:Setting_around_1900 a gc:G12_Setting ;
    rdfs:label "Around 1900"@en ;
    crm:P2_has_type sf:type_historical_period .

sf:Provence a gc:G13_Narrative_Location ;
    rdfs:label "Provence"@en ;
    crm:P67_refers_to sf:Provence_real ;
    crm:P2_has_type sf:type_region .

sf:Marius_House a gc:G13_Narrative_Location ;
    rdfs:label "Marius' house"@en ;
    crm:P2_has_type sf:type_private_location .

sf:High_and_middle_schools a gc:G13_Narrative_Location ;
    rdfs:label "High and middle schools"@en ;
    crm:P2_has_type sf:type_institutional_location .

sf:University a gc:G13_Narrative_Location ;
    rdfs:label "University"@en ;
    crm:P2_has_type sf:type_institutional_location .

sf:Paris_Kamtchatka_ride a gc:G13_Narrative_Location ;
    rdfs:label "Paris-Kamtchatka ride"@en ;
    crm:P67_refers_to sf:Paris ;
    crm:P67_refers_to sf:Kamtchatka ;
    crm:P2_has_type sf:type_route .

sf:Countryside a gc:G13_Narrative_Location ;
    rdfs:label "Countryside"@en ;
    crm:P2_has_type sf:type_natural_location .

sf:Paris a gc:G13_Narrative_Location ;
    rdfs:label "Paris"@en ;
    crm:P67_refers_to sf:Paris_real ;
    crm:P2_has_type sf:type_city .

sf:Kamtchatka a gc:G13_Narrative_Location ;
    rdfs:label "Kamtchatka"@en ;
    crm:P67_refers_to sf:Kamtchatka_real ;
    crm:P2_has_type sf:type_region .

sf:Midi a gc:G13_Narrative_Location ;
    rdfs:label "Midi"@en ;
    crm:P67_refers_to sf:Midi_real ;
    dolce:proper-part sf:Provence ;
    crm:P2_has_type sf:type_region .

sf:Midi_real a dlpcom:geographical-place ;
    rdfs:label "Midi (real)"@en ;
    crm:P2_has_type sf:type_region .

sf:Provence_real a dlpcom:geographical-place ;
    rdfs:label "Provence (real)"@en ;
    crm:P2_has_type sf:type_region .

sf:Kamtchatka_real a dlpcom:geographical-place ;
    rdfs:label "Kamtchatka (real)"@en ;
    crm:P2_has_type sf:type_region .

sf:Paris_real a dlpcom:geographical-place ;
    rdfs:label "Paris (real)"@en ;
    crm:P2_has_type sf:type_city .

sf:Age_Marius_4yo a dolce:time-interval ;
    rdfs:label "Marius is 4 years old"@en ;
    crm:P67_refers_to sf:Marius ;
    crm:P2_has_type sf:type_age .

sf:Age_Marius_20yo a dolce:time-interval ;
    rdfs:label "Marius is 20 years old"@en ;
    crm:P67_refers_to sf:Marius ;
    crm:P2_has_type sf:type_age .

sf:Event_Marius_Birth a gc:G5_Narrative_Event ;
    rdfs:label "Marius' birth"@en ;
    dolce:participant sf:Marius ;
    dlpspa:participant-place sf:Provence .

sf:Event_4th_Birthday a gc:G5_Narrative_Event ;
    rdfs:label "Marius receives a bicycle as a gift at age 4"@en ;
    dlptem:temporal-location sf:Age_Marius_4yo ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Marius_Father ;
    crm:P16_used_specific_object sf:Marius_bicycle ;
    dlptem:follows sf:Event_Marius_Birth ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_Mastering_Bicycle a gc:G5_Narrative_Event ;
    rdfs:label "Marius masters the bicycle in 5 minutes"@en ;
    dolce:participant sf:Marius ;
    crm:P16_used_specific_object sf:Marius_bicycle ;
    dlptem:follows sf:Event_4th_Birthday ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_Paris_to_Kamchatka_Ride a gc:G5_Narrative_Event ;
    rdfs:label "Marius wins the 1900 Paris-Kamchatka race"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:English_participants ;
    dlptem:follows sf:Event_Mastering_Bicycle ;
    dlpspa:participant-place sf:Paris_Kamtchatka_ride .

sf:Event_melancholy a gc:G5_Narrative_Event ;
    rdfs:label "Marius feels melancholy at age 20"@en ;
    dlptem:temporal-location sf:Age_Marius_20yo ;
    dlptem:follows sf:Event_Paris_to_Kamchatka_Ride ;
    dolce:participant sf:Marius .

sf:Event_merger_bicycle a gc:G5_Narrative_Event ;
    rdfs:label "Marius becomes one with his bicycle"@en ;
    dolce:participant sf:Marius ;
    crm:P16_used_specific_object sf:Marius_bicycle ;
    dlptem:follows sf:Event_melancholy ;
    dlpspa:participant-place sf:Countryside .

sf:Event_family_mockery a gc:G5_Narrative_Event ;
    rdfs:label "The family makes fun of Marius"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Marius_Father ;
    dlptem:follows sf:Event_merger_bicycle ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_exorcism_pastor a gc:G5_Narrative_Event ;
    rdfs:label "The pastor attempts to exorcise Marius"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Pastor ;
    crm:P16_used_specific_object sf:Holy_water ;
    dlptem:follows sf:Event_family_mockery ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_doctor_consultation a gc:G5_Narrative_Event ;
    rdfs:label "Consultation with the local doctor"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Local_Doctor ;
    crm:P16_used_specific_object sf:Doctor_potion ;
    dlptem:follows sf:Event_exorcism_pastor ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_surgeon_consultation a gc:G5_Narrative_Event ;
    rdfs:label "Consultation with five surgeons in Paris"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Paris_surgeons ;
    dlptem:follows sf:Event_doctor_consultation ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_bicycle_man_diagnosis a gc:G5_Narrative_Event ;
    rdfs:label "Diagnosis: Marius has become a bicycle man"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Paris_surgeons ;
    dlptem:follows sf:Event_surgeon_consultation ;
    dlpspa:participant-place sf:Marius_House .

sf:Event_world_celebrity a gc:G5_Narrative_Event ;
    rdfs:label "Marius becomes the most famous man in the world"@en ;
    dlptem:follows sf:Event_bicycle_man_diagnosis ;
    dolce:participant sf:Marius .

sf:Event_exhibition_proposal a gc:G5_Narrative_Event ;
    rdfs:label "American impresarios offer him a chance to exhibit"@en ;
    dolce:participant sf:Marius ;
    dlptem:follows sf:Event_world_celebrity ;
    dolce:participant sf:Impresario .

sf:Event_exhibition_refusal a gc:G5_Narrative_Event ;
    rdfs:label "Marius refuses to exhibit as an attraction"@en ;
    dlptem:follows sf:Event_exhibition_proposal ;
    dolce:participant sf:Marius .

sf:Event_legion_of_honor a gc:G5_Narrative_Event ;
    rdfs:label "Marius is named a Knight of the Legion of Honor"@en ;
    crm:P16_used_specific_object sf:Legion_of_honor ;
    dlptem:follows sf:Event_exhibition_refusal ;
    dolce:participant sf:Marius .

sf:Event_meet_Marius_Princess a gc:G5_Narrative_Event ;
    rdfs:label "Marius and the Princess meet"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Princess ;
    dlptem:follows sf:Event_legion_of_honor .

sf:Event_wedding a gc:G5_Narrative_Event ;
    rdfs:label "Marius and the Princess get married"@en ;
    dolce:participant sf:Marius ;
    dolce:participant sf:Princess ;
    dlptem:follows sf:Event_meet_Marius_Princess .

sf:Event_son_birth a gc:G5_Narrative_Event ;
    rdfs:label "Birth of a son riding a flesh-and-blood bicycle"@en ;
    dolce:participant sf:Marius_Son ;
    dlptem:follows sf:Event_wedding .

sf:Event_hybrid_race_birth a gc:G5_Narrative_Event ;
    rdfs:label "Birth of a race of bicycle men"@en ;
    dolce:participant sf:Bicycle_men_race ;
    dlptem:follows sf:Event_son_birth .

sf:Bicycle a gc:G16_Object ;
    rdfs:label "Bicycle"@en ;
    crm:P2_has_type sf:type_technological_object ;
    dlpext:setting sf:Setting_bicycle_society ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Bicycle_man a sf:H2_Concrete_Novum ;
    rdfs:label "Bicycle man"@en ;
    crm:P2_has_type sf:type_biological_novum ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Bicycle_men_race a sf:H1_Conceptual_Novum, dul:Community ;
    rdfs:label "Bicycle man race"@en ;
    crm:P2_has_type sf:type_biological_novum ;
    dul:hasMember sf:Marius ;
    dul:hasMember sf:Marius_Son ;
    crm:P2_has_type sf:type_fictive_species ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Paris_surgeons a dul:Group ;
    rdfs:label "Surgeons from Paris"@en ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Humanity_20th a dul:Community ;
    rdfs:label "Humanity of the 20th century"@en ;
    dul:hasMember sf:Marius_Father ;
    dul:hasMember sf:Princess ;
    dul:hasMember sf:King ;
    dul:hasMember sf:Local_Doctor ;
    dul:hasMember sf:Pastor ;
    crm:P2_has_type sf:type_species ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Impresario a dul:Group ;
    rdfs:label "American impresario"@en ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:English_participants a dul:Group ;
    rdfs:label "English participants"@en ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Marius_bicycle a gc:G16_Object ;
    rdfs:label "Marius' bicycle"@en ;
    crm:P2_has_type sf:type_technological_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Holy_water a gc:G16_Object ;
    rdfs:label "Holy water"@en ;
    crm:P2_has_type sf:type_religious_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Doctor_potion a gc:G16_Object ;
    rdfs:label "The potion prescribed by the doctor"@en ;
    crm:P2_has_type sf:type_medical_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Legion_of_honor a crm:E28_Conceptual_Object ;
    rdfs:label "Legion of honor"@en ;
    crm:P2_has_type sf:type_institutional_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Means_of_transportation a gc:G16_Object ;
    rdfs:label "Common means of transportation"@en ;
    crm:P2_has_type sf:type_technological_object ;
    crm:P67i_is_referred_to_by sf:Work_LHomme_Bicycle .

sf:Archetype_Strong_Southern_Man a gc:G0_Character-Stoff ;
    rdfs:label "The archetype of the strong man of the South"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Archetype_Child_prodigy a gc:G0_Character-Stoff ;
    rdfs:label "A precocious, self-taught genius"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Archetype_melancholic_hero a gc:G0_Character-Stoff ;
    rdfs:label "A melancholic hero who has achieved everything"@en ;
    crm:P130i_features_are_also_found_on sf:Marius .

sf:Pattern_man-machine_hybridization a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of human-machine hybridization"@en ;
    crm:P130i_features_are_also_found_on sf:Event_merger_bicycle .

sf:Pattern_birth_of_a_new_race a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of the birth of a new race"@en ;
    crm:P130i_features_are_also_found_on sf:Event_hybrid_race_birth .

sf:Pattern_hero_surpassing_humanity a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of the hero who transcends the limits of humanity"@en ;
    crm:P130i_features_are_also_found_on sf:Event_Mastering_Bicycle .

sf:Pattern_science_powerless_against_the_fantastic a gc:G14_Narrative-Stoff ;
    rdfs:label "The pattern of science's powerlessness in the face of the fantastical"@en ;
    crm:P130i_features_are_also_found_on sf:Event_doctor_consultation ;
    crm:P130i_features_are_also_found_on sf:Event_surgeon_consultation .
  
sf:State_melancholy a gc:G3_Psychological_State ;
    rdfs:label "Melancholy"@en ;
    dlpfun:state-of sf:Marius ;
    dlptem:temporally-overlaps sf:Event_melancholy .

sf:State_love a gc:G3_Psychological_State ;
    rdfs:label "Love"@en ;
    dlpfun:state-of sf:Princess ;
    dlptem:temporally-overlaps sf:Event_meet_Marius_Princess ;
    dlptem:temporally-overlaps sf:Event_wedding .

sf:Fabula_LHomme_Bicycle a gc:G7_Narrative_Sequence ;
    rdfs:label "Fabula L'Homme-Bicycle"@en ;
    crm:P2_has_type sf:type_fabula ;
    rdf:_1 sf:NU01 ;
    rdf:_2 sf:NU02 ;
    rdf:_3 sf:NU03 ;
    rdf:_4 sf:NU04 ;
    rdf:_5 sf:NU05 ;
    rdf:_6 sf:NU06 ;
    rdf:_7 sf:NU07 ;
    rdf:_8 sf:NU08 ;
    rdf:_9 sf:NU09 ;
    rdf:_10 sf:NU10 ;
    rdf:_11 sf:NU11 ;
    rdf:_12 sf:NU12 ;
    rdf:_13 sf:NU13 ;
    rdf:_14 sf:NU14 ;
    rdf:_15 sf:NU15 ;
    rdf:_16 sf:NU16 ;
    rdf:_17 sf:NU17 ;
    rdf:_18 sf:NU18 ;
    rdf:_19 sf:NU19 ;
    rdf:_20 sf:NU20 ;
    rdf:_21 sf:NU21 ;
    rdf:_22 sf:NU22 ;
