sf:NU01_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "The science of microbes has made immense progress since Pasteur"@en ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU02_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann finally discovers a way to create a formidable microbe"@en ;
    crm:P67_refers_to sf:Event_Discovery ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_villainy .

sf:NU03_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann names his microbe Bacillus morti-fulgurans"@en ;
    crm:P67_refers_to sf:Event_Discovery ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU04_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Mrs. Bakermann has never understood anything about the science of microbes and looks down on her husband’s work"@en ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU05_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Mrs. Bakermann gives a cold reception to the news of the discovery"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU06_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Mrs. Bakermann threatens to search the laboratory for letters from Élisa"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays "Function_interdiction" .

sf:NU07_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann denies any connection to Élisa"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU08_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Mrs. Bakermann falls asleep after dinner"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU09_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann secretly goes to the brewery"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU10_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann celebrates his discovery with César Pück, Müller, and Grossgeld"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU11_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann returns home drunk and goes to bed without waking his wife"@en ;
    crm:P67_refers_to sf:Event_Domestic_Evening ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU13_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann sends for Dr. Rothbein"@en ;
    crm:P67_refers_to sf:Event_Josepha_Death ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU14_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Josépha confesses to having entered the infernal room before losing consciousness"@en ;
    crm:P67_refers_to sf:Event_Josepha_Death ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_violation .

sf:NU15_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Rothbein diagnoses Koussmi-koussmi, a rare disease originating in Dahomey"@en ;
    crm:P67_refers_to sf:Event_Josepha_Death ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU17_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann discovers the overturned vial of Morti-fulgurans in the infernal room"@en ;
    crm:P67_refers_to sf:Event_Josepha_Death ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU18_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann realizes that his wife died from her own microbe"@en ;
    crm:P67_refers_to sf:Event_Josepha_Death ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_villainy .

sf:NU27_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann, tormented by his conscience, hesitates to confess the truth"@en ;
    crm:P67_refers_to sf:Event_Confession_Attempt ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU28_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann goes to his rival Krankwein’s house to confess his crime"@en ;
    crm:P67_refers_to sf:Event_Confession_Attempt ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU29_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Krankwein refuses to believe Bakermann and thinks he’s crazy"@en ;
    crm:P67_refers_to sf:Event_Confession_Attempt ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU30_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann hastily leaves Krankwein, struck by a sudden realization"@en ;
    crm:P67_refers_to sf:Event_Confession_Attempt ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_donor .

sf:NU32_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann works all night to develop the treatment"@en ;
    crm:P67_refers_to sf:Event_Electrical_Cure ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_magical_agent .

sf:NU33_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann publicly posts an announcement about a cure for Koussmi-koussmi using electricity"@en ;
    crm:P67_refers_to sf:Event_Electrical_Cure ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_magical_agent .

sf:NU34_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann has an electric platter built and connected to a battery"@en ;
    crm:P67_refers_to sf:Event_Electrical_Cure ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU36_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "News of the cure spreads throughout the city of Brunnwald"@en ;
    crm:P67_refers_to sf:Event_Electrical_Cure ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU41_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann becomes a global hero, showered with telegrams and honors"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_recognition,
        sf:Function_unfounded_claims .

sf:NU42_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann receives numerous awards"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_recognition,
        sf:Function_unfounded_claims .

sf:NU43_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "A fundraising campaign is launched to erect a statue of Bakermann"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_recognition,
        sf:Function_unfounded_claims .

sf:NU44_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Krankwein comes to congratulate Bakermann with a touch of irony"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU45_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann returns to his quiet life, divided between the lab and the brewery"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU46_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann regrets that his microbe is known as Koussmi-koussmi rather than Morti-fulgurans"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann .

sf:NU47_Le_Microbe_Du_Professeur_Bakermann a gc:G9_Narrative_Unit ;
    rdfs:label "Bakermann consoles himself by working on an even more formidable microbe"@en ;
    crm:P67_refers_to sf:Event_Bakermann_Aftermath ;
    dolce:proper-part-of sf:Work_Le_Microbe_Du_Professeur_Bakermann ;
    dlpext:plays sf:Function_lack .

